{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "didyouseo": {
      "type": "streamable-http",
      "url": "https://didyouseo.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://didyouseo.com/api/oauth/authorize",
            "tokenUrl": "https://didyouseo.com/api/oauth/token",
            "baseScopes": ["audit:read", "audit:write", "sites:read", "sites:write"]
          }
        }
      }
    }
  }
}
